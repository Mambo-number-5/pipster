{
    "name": "Pipster Bot - Dev Environment",
    // Puntiamo ai tuoi file compose esistenti
    "dockerComposeFile": [
        "../docker-compose.yml",
        "../docker-compose.override.yml"
    ],
    // Diciamo a VS Code di entrare nel servizio "bot"
    "service": "bot",
    "workspaceFolder": "/app",
    // NUOVO: Specifichiamo l'utente creato nel Dockerfile
    "remoteUser": "pipster",
    // Questa parte silenzia il warning nel terminale di VS Code
    "containerEnv": {
        "PIP_ROOT_USER_ACTION": "ignore"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python", // Supporto Python
                "ms-python.vscode-pylance", // Suggerimenti intelligenti (risolve le linee rosse)
                "njpwerner.autodocstring", // Per documentare la statistica velocemente
                "ms-azuretools.vscode-docker", // Gestione container da VS Code
                "redhat.vscode-yaml", // Autocompletamento per i file .yml
                "esbenp.prettier-vscode", // Formattazione del codice
                "continue.continue" // Chat AI integrata (Sostituto del browser per Qwen e Gemini)
            ],
            "settings": {
                // Usa il Python del container, dove CCXT e Redis sono già installati
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "python.analysis.typeCheckingMode": "basic",
                "editor.formatOnSave": true,
                "extensions.ignoreRecommendations": true // Evita installazioni automatiche non desiderate
            }
        }
    }
}